# Active LLM provider: groq | openrouter | sambanova | ollama
FORGE_PROVIDER=groq

# API keys (only required for the selected hosted provider)
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=

# Local Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional per-role model overrides
FORGE_FACTORY_MODEL=
FORGE_AGENT_MODEL=
FORGE_JUDGE_MODEL=

